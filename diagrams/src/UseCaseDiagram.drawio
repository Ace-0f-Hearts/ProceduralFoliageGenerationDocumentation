        <mxCell id="hLDd039O1aKlYjQ7S4JM-37" value="&lt;div style=&quot;background-color:#1e1a1b;color:#e4e0e1&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:12.0pt;&quot;&gt;&lt;span style=&quot;color:#d17458;&quot;&gt;class &lt;/span&gt;Object&lt;br&gt;{&lt;br&gt;&lt;span style=&quot;color:#d17458;&quot;&gt;public&lt;/span&gt;:&lt;br&gt;    &lt;span style=&quot;color:#d69568;&quot;&gt;Object&lt;/span&gt;();&lt;br&gt;    &lt;span style=&quot;color:#d69568;&quot;&gt;Object&lt;/span&gt;(std::shared_ptr&amp;lt;Symbol&amp;gt; &lt;span style=&quot;color:#f4bf94;&quot;&gt;symbol&lt;/span&gt;);&lt;br&gt;    &lt;span style=&quot;color:#d69568;&quot;&gt;Object&lt;/span&gt;(&lt;span style=&quot;color:#d17458;&quot;&gt;const &lt;/span&gt;Object&amp;amp; &lt;span style=&quot;color:#f4bf94;&quot;&gt;other&lt;/span&gt;);&lt;br&gt;    &lt;span style=&quot;color:#d69568;&quot;&gt;Object&lt;/span&gt;(&lt;span style=&quot;color:#d17458;&quot;&gt;const &lt;/span&gt;Object&amp;amp;&amp;amp; &lt;span style=&quot;color:#f4bf94;&quot;&gt;other&lt;/span&gt;) &lt;span style=&quot;color:#d17458;&quot;&gt;noexcept&lt;/span&gt;;&lt;br&gt;&lt;br&gt;    Object&amp;amp; &lt;span style=&quot;color:#d17458;&quot;&gt;operator&lt;/span&gt;=(&lt;span style=&quot;color:#d17458;&quot;&gt;const &lt;/span&gt;Object&amp;amp; &lt;span style=&quot;color:#f4bf94;&quot;&gt;other&lt;/span&gt;);&lt;br&gt;    Object&amp;amp; &lt;span style=&quot;color:#d17458;&quot;&gt;operator&lt;/span&gt;=(Object&amp;amp;&amp;amp; &lt;span style=&quot;color:#f4bf94;&quot;&gt;other&lt;/span&gt;) &lt;span style=&quot;color:#d17458;&quot;&gt;noexcept&lt;/span&gt;;&lt;br&gt;    &lt;span style=&quot;color:#d17458;&quot;&gt;virtual &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;~Object&lt;/span&gt;();&lt;br&gt;&lt;br&gt;    [[nodiscard]] std::list&amp;lt;Spatial::Spatial2D&amp;gt; &lt;span style=&quot;color:#d69568;&quot;&gt;GetPoints&lt;/span&gt;() &lt;span style=&quot;color:#d17458;&quot;&gt;const&lt;/span&gt;;&lt;br&gt;&lt;br&gt;    &lt;span style=&quot;color:#d17458;&quot;&gt;void &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;SetSymbol&lt;/span&gt;(std::shared_ptr&amp;lt;Symbol&amp;gt; &lt;span style=&quot;color:#f4bf94;&quot;&gt;symbol&lt;/span&gt;);&lt;br&gt;    &lt;span style=&quot;color:#d17458;&quot;&gt;void &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;SetType&lt;/span&gt;(ObjectType &lt;span style=&quot;color:#f4bf94;&quot;&gt;type&lt;/span&gt;);&lt;br&gt;    &lt;span style=&quot;color:#d17458;&quot;&gt;void &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;AppendCoordinate&lt;/span&gt;(Spatial::Spatial2D &lt;span style=&quot;color:#f4bf94;&quot;&gt;coordinate&lt;/span&gt;);&lt;br&gt;&lt;br&gt;    &lt;span style=&quot;color:#d17458;&quot;&gt;bool &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;HasSymbolOf&lt;/span&gt;(&lt;span style=&quot;color:#d17458;&quot;&gt;const &lt;/span&gt;Symbol* &lt;span style=&quot;color:#f4bf94;&quot;&gt;symbol&lt;/span&gt;) &lt;span style=&quot;color:#d17458;&quot;&gt;const&lt;/span&gt;;&lt;br&gt;&lt;br&gt;    &lt;span style=&quot;color:#d17458;&quot;&gt;virtual bool &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;IsIntersecting&lt;/span&gt;(&lt;span style=&quot;color:#d17458;&quot;&gt;const &lt;/span&gt;Spatial::Spatial2D&amp;amp; &lt;span style=&quot;color:#f4bf94;&quot;&gt;point&lt;/span&gt;) &lt;span style=&quot;color:#d17458;&quot;&gt;const &lt;/span&gt;= &lt;span style=&quot;color:#ddbe6d;&quot;&gt;0&lt;/span&gt;;&lt;br&gt;&lt;br&gt;    [[nodiscard]] ObjectType &lt;span style=&quot;color:#d69568;&quot;&gt;type&lt;/span&gt;() &lt;span style=&quot;color:#d17458;&quot;&gt;const&lt;/span&gt;;&lt;br&gt;    [[nodiscard]] &lt;span style=&quot;color:#d17458;&quot;&gt;const &lt;/span&gt;std::shared_ptr&amp;lt;Symbol&amp;gt; &lt;span style=&quot;color:#d69568;&quot;&gt;symbol&lt;/span&gt;() &lt;span style=&quot;color:#d17458;&quot;&gt;const&lt;/span&gt;;&lt;br&gt;    [[nodiscard]] Spatial::SegmentedPath &lt;span style=&quot;color:#d69568;&quot;&gt;coordinates&lt;/span&gt;() &lt;span style=&quot;color:#d17458;&quot;&gt;const&lt;/span&gt;;&lt;br&gt;    [[nodiscard]] BoundingBox2D &lt;span style=&quot;color:#d69568;&quot;&gt;bounding_box&lt;/span&gt;() &lt;span style=&quot;color:#d17458;&quot;&gt;const&lt;/span&gt;;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#d17458;&quot;&gt;protected&lt;/span&gt;:&lt;br&gt;    &lt;span style=&quot;color:#d17458;&quot;&gt;void &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;UpdateBoundingBox&lt;/span&gt;();&lt;br&gt;&lt;br&gt;    &lt;span style=&quot;color:#d17458;&quot;&gt;float &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;angle_&lt;/span&gt;;&lt;br&gt;    ObjectType &lt;span style=&quot;color:#d69568;&quot;&gt;type_&lt;/span&gt;;&lt;br&gt;    std::shared_ptr&amp;lt;Symbol&amp;gt; &lt;span style=&quot;color:#d69568;&quot;&gt;symbol_&lt;/span&gt;;&lt;br&gt;&lt;br&gt;    Spatial::SegmentedPath &lt;span style=&quot;color:#d69568;&quot;&gt;coordinates_&lt;/span&gt;;&lt;br&gt;    BoundingBox2D &lt;span style=&quot;color:#d69568;&quot;&gt;bounding_box_&lt;/span&gt;;&lt;br&gt;&lt;br&gt;};&lt;/pre&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
