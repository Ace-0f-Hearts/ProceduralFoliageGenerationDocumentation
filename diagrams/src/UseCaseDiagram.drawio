        <mxCell id="hLDd039O1aKlYjQ7S4JM-39" value="&lt;div style=&quot;background-color:#1e1a1b;color:#e4e0e1&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:12.0pt;&quot;&gt;    &lt;span style=&quot;color:#d17458;&quot;&gt;class &lt;/span&gt;PathObject : &lt;span style=&quot;color:#d17458;&quot;&gt;public &lt;/span&gt;Object&lt;br&gt;    {&lt;br&gt;    &lt;span style=&quot;color:#d17458;&quot;&gt;public&lt;/span&gt;:&lt;br&gt;        &lt;span style=&quot;color:#d69568;&quot;&gt;PathObject&lt;/span&gt;() = &lt;span style=&quot;color:#d17458;&quot;&gt;delete&lt;/span&gt;;&lt;br&gt;        &lt;span style=&quot;color:#d69568;&quot;&gt;PathObject&lt;/span&gt;(std::shared_ptr&amp;lt;Symbol&amp;gt; &lt;span style=&quot;color:#f4bf94;&quot;&gt;symbol&lt;/span&gt;);&lt;br&gt;&lt;br&gt;        &lt;span style=&quot;color:#d69568;&quot;&gt;~PathObject&lt;/span&gt;() &lt;span style=&quot;color:#d17458;&quot;&gt;override &lt;/span&gt;= &lt;span style=&quot;color:#d17458;&quot;&gt;default&lt;/span&gt;;&lt;br&gt;&lt;br&gt;        [[nodiscard]] &lt;span style=&quot;color:#d17458;&quot;&gt;bool &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;Contains&lt;/span&gt;(&lt;span style=&quot;color:#d17458;&quot;&gt;const &lt;/span&gt;Spatial::Spatial2D&amp;amp; &lt;span style=&quot;color:#f4bf94;&quot;&gt;point&lt;/span&gt;) &lt;span style=&quot;color:#d17458;&quot;&gt;const&lt;/span&gt;;&lt;br&gt;        &lt;span style=&quot;color:#9b796a;font-style:italic;&quot;&gt;/**&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#9b796a;font-style:italic;&quot;&gt;         * Used for querying intersections with points. Depending on whether the path object designates an area or not, the intersection will account to the actual area of the path, or the area that&#39;s surrounded by it.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#9b796a;font-style:italic;&quot;&gt;         * @param point&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#9b796a;font-style:italic;&quot;&gt;         * @return&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#9b796a;font-style:italic;&quot;&gt;         */&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#9b796a;font-style:italic;&quot;&gt;        &lt;/span&gt;[[nodiscard]]&lt;span style=&quot;color:#d17458;&quot;&gt;bool &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;IsIntersecting&lt;/span&gt;(&lt;span style=&quot;color:#d17458;&quot;&gt;const &lt;/span&gt;Spatial::Spatial2D&amp;amp; &lt;span style=&quot;color:#f4bf94;&quot;&gt;point&lt;/span&gt;) &lt;span style=&quot;color:#d17458;&quot;&gt;const override &lt;/span&gt;;&lt;br&gt;&lt;br&gt;&lt;br&gt;        &lt;span style=&quot;color:#9b796a;font-style:italic;&quot;&gt;/**&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#9b796a;font-style:italic;&quot;&gt;         * Computes a path consisting of poly lines from a series of coordinates representing a Bezier spline.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#9b796a;font-style:italic;&quot;&gt;         * @param curve&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#9b796a;font-style:italic;&quot;&gt;         */&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#9b796a;font-style:italic;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color:#d17458;&quot;&gt;void &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;BuildCurve&lt;/span&gt;(std::vector&amp;lt;ObjectCoordinate&amp;gt;&amp;amp; &lt;span style=&quot;color:#f4bf94;&quot;&gt;curve&lt;/span&gt;);&lt;br&gt;        &lt;span style=&quot;color:#d17458;&quot;&gt;void &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;SetCurve&lt;/span&gt;(&lt;span style=&quot;color:#d17458;&quot;&gt;const &lt;/span&gt;std::vector&amp;lt;Spatial::Spatial2D&amp;gt;&amp;amp; &lt;span style=&quot;color:#f4bf94;&quot;&gt;points&lt;/span&gt;);&lt;br&gt;        &lt;span style=&quot;color:#d17458;&quot;&gt;void &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;AppendPoint&lt;/span&gt;(&lt;span style=&quot;color:#d17458;&quot;&gt;const &lt;/span&gt;Spatial::Spatial2D&amp;amp; &lt;span style=&quot;color:#f4bf94;&quot;&gt;point&lt;/span&gt;);&lt;br&gt;        &lt;span style=&quot;color:#d17458;&quot;&gt;void &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;RemovePoint&lt;/span&gt;(&lt;span style=&quot;color:#d17458;&quot;&gt;const &lt;/span&gt;Spatial::Spatial2D&amp;amp; &lt;span style=&quot;color:#f4bf94;&quot;&gt;point&lt;/span&gt;);&lt;br&gt;        &lt;span style=&quot;color:#d17458;&quot;&gt;void &lt;/span&gt;&lt;span style=&quot;color:#d69568;&quot;&gt;Clear&lt;/span&gt;();&lt;br&gt;    };&lt;br&gt;}&lt;br&gt;&lt;/pre&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
