        <mxCell id="hLDd039O1aKlYjQ7S4JM-38" value="&lt;div style=&quot;background-color:#1e1a1b;color:#e4e0e1&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:12.0pt;&quot;&gt;&lt;span style=&quot;color:#d17458;&quot;&gt;enum &lt;/span&gt;ObjectType&lt;br&gt;{&lt;br&gt;    PointO = &lt;span style=&quot;color:#ddbe6d;&quot;&gt;0x1&lt;/span&gt;,&lt;br&gt;    PathO = &lt;span style=&quot;color:#ddbe6d;&quot;&gt;0x2&lt;/span&gt;,&lt;br&gt;    AreaO = &lt;span style=&quot;color:#ddbe6d;&quot;&gt;0x4&lt;/span&gt;,&lt;br&gt;    UnknownO = &lt;span style=&quot;color:#ddbe6d;&quot;&gt;0x8&lt;/span&gt;,&lt;br&gt;};&lt;br&gt;&lt;/pre&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
